astro
---
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Portfolio | Rolando Capuma</title>
  </head>
  <body class="bg-slate-900 text-slate-100 font-sans antialiased">

    <header class="container mx-auto px-4 py-8 flex justify-between items-center border-b border-slate-700">
      <h1 class="text-2xl font-bold text-teal-400">Rolando Capuma</h1>
      <nav>
        <ul class="flex space-x-6">
          <li><a href="#proyectos" class="hover:text-teal-300 transition-colors">Proyectos</a></li>
          <li><a href="#habilidades" class="hover:text-teal-300 transition-colors">Habilidades</a></li>
          <li><a href="#contacto" class="hover:text-teal-300 transition-colors">Contacto</a></li>
        </ul>
      </nav>
    </header>

    <main class="container mx-auto px-4 py-16">
      <section class="text-center mb-20">
        <h2 class="text-5xl font-extrabold mb-4">Desarrollador Full-Stack</h2>
        <p class="text-xl text-slate-400 max-w-2xl mx-auto">Construyendo soluciones eficientes con ASP.NET Core, Astro y bases de datos relacionales.</p>
      </section>

      <!-- Sección de Habilidades -->
          <section id="habilidades" class="mb-24 scroll-mt-24">
            <h3 class="text-3xl font-bold mb-8 border-b-2 border-teal-500 inline-block pb-2">Mis Habilidades</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4 text-center font-medium">
              <div class="bg-slate-800 p-4 rounded-lg shadow-md border border-slate-700 hover:border-teal-400 transition-colors">C# y ASP.NET Core MVC</div>
              <div class="bg-slate-800 p-4 rounded-lg shadow-md border border-slate-700 hover:border-teal-400 transition-colors">SQL Server y Vistas</div>
              <div class="bg-slate-800 p-4 rounded-lg shadow-md border border-slate-700 hover:border-teal-400 transition-colors">Python (OOP)</div>
              <div class="bg-slate-800 p-4 rounded-lg shadow-md border border-slate-700 hover:border-teal-400 transition-colors">Git y GitHub</div>
              <div class="bg-slate-800 p-4 rounded-lg shadow-md border border-slate-700 hover:border-teal-400 transition-colors">HTML y CSS</div>
              <div class="bg-slate-800 p-4 rounded-lg shadow-md border border-slate-700 hover:border-teal-400 transition-colors">Scrum y Metodologías Ágiles</div>
            </div>
          </section>

          <!-- Sección de Proyectos -->
          <section id="proyectos" class="mb-20 scroll-mt-24">
            <h3 class="text-3xl font-bold mb-8 border-b-2 border-teal-500 inline-block pb-2">Proyectos Destacados</h3>
            <div class="grid md:grid-cols-2 gap-8">
              
              <!-- Proyecto 1 -->
              <div class="bg-slate-800 rounded-xl overflow-hidden shadow-lg border border-slate-700 hover:border-teal-400 transition-all hover:-translate-y-1">
                <div class="p-6">
                  <h4 class="text-xl font-bold text-teal-300 mb-2">Dashboard Web Universitario</h4>
                  <p class="text-slate-400 mb-4 text-sm">Aplicación de panel de control estructurada con controladores en C# e integración de base de datos para la gestión de información.</p>
                  <div class="flex flex-wrap gap-2">
                    <span class="bg-slate-700 text-xs px-2 py-1 rounded text-teal-100">ASP.NET Core</span>
                    <span class="bg-slate-700 text-xs px-2 py-1 rounded text-teal-100">SQL Server</span>
                  </div>
                </div>
              </div>

              <!-- Proyecto 2 -->
              <div class="bg-slate-800 rounded-xl overflow-hidden shadow-lg border border-slate-700 hover:border-teal-400 transition-all hover:-translate-y-1">
                <div class="p-6">
                  <h4 class="text-xl font-bold text-teal-300 mb-2">Base de Datos "Eventos Capuma"</h4>
                  <p class="text-slate-400 mb-4 text-sm">Diseño y creación de base de datos relacional orientada a eventos, implementando vistas SQL complejas y datos de prueba.</p>
                  <div class="flex flex-wrap gap-2">
                    <span class="bg-slate-700 text-xs px-2 py-1 rounded text-teal-100">SQL Server</span>
                    <span class="bg-slate-700 text-xs px-2 py-1 rounded text-teal-100">Dapper</span>
                  </div>
                </div>
              </div>

              <!-- Proyecto 3 -->
              <div class="bg-slate-800 rounded-xl overflow-hidden shadow-lg border border-slate-700 hover:border-teal-400 transition-all hover:-translate-y-1">
                <div class="p-6">
                  <h4 class="text-xl font-bold text-teal-300 mb-2">Simulador OOP</h4>
                  <p class="text-slate-400 mb-4 text-sm">Desarrollo de script aplicando Programación Orientada a Objetos, herencia y polimorfismo mediante clases (Personaje, Soldado, Campesino).</p>
                  <div class="flex flex-wrap gap-2">
                    <span class="bg-slate-700 text-xs px-2 py-1 rounded text-teal-100">Python</span>
                    <span class="bg-slate-700 text-xs px-2 py-1 rounded text-teal-100">OOP</span>
                  </div>
                </div>
              </div>

              <!-- Proyecto 4 -->
              <div class="bg-slate-800 rounded-xl overflow-hidden shadow-lg border border-slate-700 hover:border-teal-400 transition-all hover:-translate-y-1">
                <div class="p-6">
                  <h4 class="text-xl font-bold text-teal-300 mb-2">Estrategia EcoObra</h4>
                  <p class="text-slate-400 mb-4 text-sm">Propuesta de modelo de negocio y estrategia de triple impacto para un marketplace de materiales de construcción en Rosario.</p>
                  <div class="flex flex-wrap gap-2">
                    <span class="bg-slate-700 text-xs px-2 py-1 rounded text-teal-100">Análisis de Mercado</span>
                    <span class="bg-slate-700 text-xs px-2 py-1 rounded text-teal-100">Gestión</span>
                  </div>
                </div>
              </div>

            </div>
          </section>

    </main>

    <footer class="container mx-auto px-4 py-8 text-center text-slate-500 border-t border-slate-700 mt-20">
      <p>&copy; 2026 Rolando Capuma. Todos los derechos reservados.</p>
    </footer>

  </body>
</html>